page {
  min-height: 100%;
  background: linear-gradient(135deg, #f8f0e9 0%, #edf4f1 50%, #f7f1e5 100%);
  color: #20242a;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view,
text,
button,
input,
picker,
textarea {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 8px;
  line-height: 1;
}

button::after {
  border: 0;
}
