.manager-page { padding: 24rpx; }
.editor-card, .list-card { border: 1rpx solid rgba(206,188,161,.9); border-radius: 16rpx; background: rgba(255,253,248,.96); box-shadow: 0 18rpx 48rpx rgba(57,50,42,.1); padding: 24rpx; }
.list-card { margin-top: 20rpx; }
.card-heading, .list-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 20rpx; }
.card-heading { margin-bottom: 22rpx; }
.card-heading > view:first-child { flex: 1; min-width: 0; }
.list-heading > view:first-child { flex: 1; min-width: 0; }
.eyebrow, .page-title, .hint, .field > text, .diary-date, .diary-title, .diary-excerpt { display: block; }
.eyebrow { color: #176f76; font-size: 20rpx; font-weight: 900; }
.page-title { margin-top: 4rpx; font-size: 38rpx; font-weight: 900; }
.hint { color: #74808c; font-size: 20rpx; text-align: right; }
.field { margin-top: 16rpx; }
.compact-date { width: 52%; }
.field > text { margin-bottom: 8rpx; color: #3f4854; font-size: 22rpx; font-weight: 800; }
.field input, .picker-value, .search-field input, .filter-value { min-height: 72rpx; border: 1rpx solid #d8c7ad; border-radius: 10rpx; background: #fffdf8; padding: 0 18rpx; font-size: 26rpx; }
.picker-value, .filter-value { display: flex; align-items: center; }
.field textarea { width: 100%; height: 300rpx; border: 1rpx solid #d8c7ad; border-radius: 10rpx; background: #fffdf8; padding: 18rpx; font-size: 26rpx; line-height: 1.7; }
.editor-actions, .filter-row, .item-actions { display: flex; gap: 12rpx; }
.editor-actions { width: 100%; justify-content: flex-end; margin-top: 18rpx; }
.editor-actions button:first-child { margin-left: auto; }
.editor-actions button, .list-heading button, .item-actions button { min-height: 60rpx; padding: 0 20rpx; border: 1rpx solid #d8c7ad; background: #fffdf8; font-size: 22rpx; font-weight: 900; }
.list-heading button { margin-left: auto; }
.editor-actions .primary { min-height: 68rpx; padding: 0 30rpx; border-color: #176f76; background: #176f76; color: white; font-size: 24rpx; }
.list-title { font-size: 30rpx; font-weight: 900; }
.result-count { margin-left: 12rpx; color: #176f76; font-size: 21rpx; font-weight: 900; }
.search-field { margin-top: 20rpx; }
.filter-row { margin-top: 12rpx; }
.filter-picker { flex: 1; min-width: 0; }
.filter-value { justify-content: center; font-size: 23rpx; font-weight: 800; }
.diary-card { padding: 22rpx 0; border-top: 1rpx solid #eadfce; }
.diary-card:first-of-type { margin-top: 18rpx; }
.diary-main { min-width: 0; }
.diary-date { color: #176f76; font-size: 20rpx; font-weight: 900; }
.diary-title { margin-top: 6rpx; font-size: 29rpx; font-weight: 900; }
.diary-excerpt { display: -webkit-box; overflow: hidden; margin-top: 8rpx; color: #66717d; font-size: 23rpx; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 3; white-space: pre-wrap; }
.diary-card .item-actions { width: 100%; justify-content: flex-end; margin-top: 16rpx; }
.item-actions button:first-child { margin-left: auto; }
.item-actions .danger { color: #c94635; }
.empty { padding: 54rpx 0; color: #74808c; text-align: center; font-size: 24rpx; }
