.page {
  padding: 28rpx;
}

.topbar {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding: 10rpx 0 24rpx;
}

.eyebrow,
.title {
  display: block;
}

.eyebrow {
  color: #176f76;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.title {
  margin-top: 8rpx;
  color: #20242a;
  font-size: 64rpx;
  font-weight: 900;
  line-height: 1;
}

.gear,
.control-button,
.picker-button,
.nav-button,
.form-line button,
.section-title button,
.todo-item button,
.event-item button {
  width: auto;
  min-height: 72rpx;
  padding: 0 24rpx;
  border: 1rpx solid #d8c7ad;
  background: #fffdf8;
  color: #20242a;
  font-size: 26rpx;
  font-weight: 800;
}

.gear {
  flex: 0 0 144rpx;
  width: 144rpx;
  min-width: 144rpx;
}

.month-card,
.detail-card,
.settings-card {
  border: 1rpx solid rgba(206, 188, 161, 0.9);
  border-radius: 16rpx;
  background: rgba(255, 253, 248, 0.96);
  box-shadow: 0 20rpx 58rpx rgba(57, 50, 42, 0.12);
}

.month-card,
.settings-card {
  padding: 22rpx;
}

.month-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-button {
  flex: 0 0 72rpx;
  width: 72rpx;
  min-width: 72rpx;
  padding: 0;
  font-size: 42rpx;
}

.month-title {
  flex: 1;
  min-width: 0;
  padding: 0 16rpx;
  text-align: center;
}

.month-title text {
  display: block;
}

.month-title text:first-child {
  font-size: 38rpx;
  font-weight: 900;
}

.month-meta {
  margin-top: 8rpx;
  color: #74808c;
  font-size: 22rpx;
}

.controls {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  margin: 22rpx 0;
}

.controls > button,
.controls > picker {
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
}

.controls > picker {
  flex-grow: 1.2;
}

.controls > button:last-child {
  margin-right: 0;
}

.control-button,
.picker-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 72rpx;
  padding: 0 10rpx;
  line-height: 1;
  text-align: center;
}

.primary {
  border-color: #176f76;
  background: #176f76;
  color: #ffffff;
}

.weekday-grid,
.calendar-grid {
  display: flex;
  flex-wrap: wrap;
  width: 100%;
}

.weekday-grid {
  margin-bottom: 10rpx;
  color: #74808c;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
}

.weekday-grid text {
  flex: 0 0 14.285714%;
  width: 14.285714%;
}

.day-cell {
  position: relative;
  display: flex;
  flex: 0 0 14.285714%;
  width: 14.285714%;
  min-width: 0;
  min-height: 104rpx;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-start;
  padding: 12rpx 10rpx;
  border: 1rpx solid #eadfce;
  border-radius: 8rpx;
  background: #fffaf1;
  color: #20242a;
  text-align: left;
}

.day-background,
.day-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.day-background {
  z-index: 0;
  width: 100%;
  height: 100%;
}

.day-shade {
  z-index: 1;
  background: rgba(255, 250, 241, 0.56);
}

.day-cell.muted .day-shade {
  background: rgba(255, 253, 248, 0.72);
}

.day-cell.today .day-shade {
  background: rgba(255, 250, 241, 0.48);
}

.day-cell.selected .day-shade {
  background: rgba(23, 111, 118, 0.74);
}

.day-cell > text {
  position: relative;
  z-index: 2;
}

.day-cell.muted {
  opacity: 0.42;
}

.day-cell.today {
  border-color: #c94635;
}

.day-cell.selected {
  background: #176f76;
  color: #ffffff;
}

.day-cell.holiday .solar-day {
  color: #c94635;
}

.day-cell.selected .solar-day,
.day-cell.selected .lunar-day,
.day-cell.selected .day-mark {
  color: #ffffff;
}

.solar-day {
  font-size: 30rpx;
  font-weight: 900;
}

.lunar-day,
.day-mark {
  display: block;
  max-width: 100%;
  overflow: hidden;
  color: #74808c;
  font-size: 18rpx;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.day-mark {
  margin-top: 4rpx;
  color: #c94635;
}

.settings-card,
.detail-card {
  margin-top: 22rpx;
}

.section-title,
.switch-row,
.info-row,
.event-item,
.history-item,
.todo-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.section-title {
  margin-bottom: 14rpx;
  font-size: 30rpx;
  font-weight: 900;
}

.switch-row {
  padding: 16rpx 0;
  border-top: 1rpx solid #eadfce;
}

.detail-card {
  overflow: hidden;
}

.date-hero {
  padding: 28rpx;
  background: linear-gradient(135deg, #fff7eb, #eef7f4);
  text-align: center;
}

.date-hero text {
  display: block;
}

.weekday {
  color: #176f76;
  font-size: 24rpx;
  font-weight: 800;
}

.big-day {
  margin: 8rpx 0;
  color: #c94635;
  font-size: 112rpx;
  font-weight: 900;
  line-height: 1;
}

.solar {
  font-size: 32rpx;
  font-weight: 900;
}

.lunar {
  margin-top: 8rpx;
  color: #3f4854;
  font-size: 26rpx;
}

.almanac {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  margin-top: 20rpx;
}

.almanac text {
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
  padding: 14rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.74);
  color: #3f4854;
  font-size: 23rpx;
}

.almanac text:last-child {
  margin-right: 0;
}

.info-section {
  padding: 24rpx 28rpx;
  border-top: 1rpx solid #eadfce;
}

.section-heading {
  display: block;
  margin-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: 900;
}

.info-row,
.event-item,
.history-item,
.todo-item {
  padding: 14rpx 0;
  border-top: 1rpx solid rgba(234, 223, 206, 0.72);
  color: #3f4854;
  font-size: 25rpx;
}

.info-row text:first-child,
.event-item text:first-child,
.history-item text:first-child {
  flex: 0 0 auto;
  color: #74808c;
  font-weight: 800;
}

.info-row text:last-child,
.event-item text:last-child,
.history-item text:last-child {
  flex: 1;
  min-width: 0;
  text-align: right;
}

.recommend-grid {
  display: flex;
  flex-direction: column;
}

.recommend-item {
  margin-bottom: 12rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #f6efe4;
}

.recommend-item:last-child {
  margin-bottom: 0;
}

.recommend-item text {
  display: block;
}

.recommend-item text:first-child {
  margin-bottom: 8rpx;
  color: #176f76;
  font-weight: 900;
}

.form-line {
  display: flex;
  align-items: stretch;
}

.form-line input {
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
  min-height: 72rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d8c7ad;
  border-radius: 10rpx;
  background: #fffdf8;
}

.form-line button {
  flex: 0 0 132rpx;
  width: 132rpx;
}

.empty {
  padding: 18rpx 0 4rpx;
  color: #74808c;
  font-size: 24rpx;
}

.todo-item {
  justify-content: flex-start;
}

.todo-item text {
  flex: 1;
  min-width: 0;
}

.todo-item .done {
  color: #9aa3ad;
  text-decoration: line-through;
}
