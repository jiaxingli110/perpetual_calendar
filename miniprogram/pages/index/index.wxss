.page {
  padding: 28rpx;
}

.topbar {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding: 10rpx 0 24rpx;
}

.topbar > view:first-child {
  flex: 1;
  min-width: 0;
}

.eyebrow,
.title {
  display: block;
}

.eyebrow {
  color: #176f76;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.title {
  margin-top: 8rpx;
  color: #20242a;
  font-size: 64rpx;
  font-weight: 900;
  line-height: 1;
}

.gear,
.control-button,
.picker-button,
.nav-button,
.form-line button,
.section-title button,
.todo-item button,
.event-item button {
  width: auto;
  min-height: 72rpx;
  padding: 0 24rpx;
  border: 1rpx solid #d8c7ad;
  background: #fffdf8;
  color: #20242a;
  font-size: 26rpx;
  font-weight: 800;
}

.gear {
  flex: 0 0 72rpx;
  width: 72rpx;
  min-width: 72rpx;
  margin-left: auto;
  padding: 0;
  font-size: 38rpx;
}

.month-card,
.detail-card,
.settings-card {
  border: 1rpx solid rgba(206, 188, 161, 0.9);
  border-radius: 16rpx;
  background: rgba(255, 253, 248, 0.96);
  box-shadow: 0 20rpx 58rpx rgba(57, 50, 42, 0.12);
}

.month-card,
.settings-card {
  padding: 22rpx;
}

.month-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-button {
  flex: 0 0 72rpx;
  width: 72rpx;
  min-width: 72rpx;
  padding: 0;
  font-size: 42rpx;
}

.month-title {
  flex: 1;
  min-width: 0;
  padding: 0 16rpx;
  text-align: center;
}

.month-title text {
  display: block;
}

.month-title text:first-child {
  font-size: 38rpx;
  font-weight: 900;
}

.month-meta {
  margin-top: 8rpx;
  color: #74808c;
  font-size: 22rpx;
}

.controls {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  margin: 22rpx 0;
}

.controls > button,
.controls > picker {
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
}

.controls > picker {
  flex-grow: 1.2;
}

.controls > button:last-child {
  margin-right: 0;
}

.control-button,
.picker-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 72rpx;
  padding: 0 10rpx;
  line-height: 1;
  text-align: center;
}

.primary {
  border-color: #176f76;
  background: #176f76;
  color: #ffffff;
}

.weekday-grid,
.calendar-grid {
  display: flex;
  flex-wrap: wrap;
  width: 100%;
}

.weekday-grid {
  margin-bottom: 10rpx;
  color: #74808c;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
}

.weekday-grid text {
  flex: 0 0 14.285714%;
  width: 14.285714%;
}

.weekday-grid .weekend {
  color: #c94635;
  font-weight: 900;
}

.day-cell {
  position: relative;
  display: flex;
  flex: 0 0 14.285714%;
  width: 14.285714%;
  min-width: 0;
  min-height: 104rpx;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-start;
  padding: 12rpx 10rpx;
  border: 1rpx solid #eadfce;
  border-radius: 8rpx;
  background: #fffaf1;
  color: #20242a;
  text-align: left;
}

.day-background,
.day-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.day-background {
  z-index: 0;
  width: 100%;
  height: 100%;
}

.day-shade {
  z-index: 1;
  background: rgba(255, 250, 241, 0.56);
}

.day-cell.muted .day-shade {
  background: rgba(255, 253, 248, 0.72);
}

.day-cell.today .day-shade {
  background: rgba(255, 250, 241, 0.48);
}

.day-cell.selected .day-shade {
  background: rgba(23, 111, 118, 0.74);
}

.day-cell > text {
  position: relative;
  z-index: 2;
}

.day-indicators {
  position: absolute;
  right: 5rpx;
  bottom: 5rpx;
  z-index: 3;
  display: flex;
  gap: 4rpx;
}

.day-indicators text {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24rpx;
  height: 24rpx;
  border-radius: 6rpx;
  color: #ffffff;
  font-size: 15rpx;
  font-weight: 900;
  line-height: 1;
}

.todo-indicator { background: #176f76; }
.anniversary-indicator { background: #c98a26; }
.diary-indicator { background: #6f5d91; }
.day-cell.selected .day-indicators text { box-shadow: 0 0 0 1rpx rgba(255,255,255,.72); }

.day-cell.muted {
  opacity: 0.42;
}

.day-cell.today {
  border-color: #c94635;
}

.day-cell.selected {
  background: #176f76;
  color: #ffffff;
}

.day-cell.holiday .solar-day {
  color: #c94635;
}

.day-cell.weekend .solar-day {
  color: #c94635;
}

.day-cell.holiday {
  border-color: rgba(201, 70, 53, 0.58);
  background: linear-gradient(180deg, rgba(255, 238, 232, 0.92), rgba(255, 253, 248, 0.96));
  box-shadow: inset 0 0 0 2rpx rgba(201, 70, 53, 0.1);
}

.day-cell.workday {
  border-color: rgba(89, 98, 110, 0.5);
  box-shadow: inset 0 4rpx 0 rgba(89, 98, 110, 0.55);
}

.holiday-status {
  position: absolute !important;
  top: 6rpx;
  right: 6rpx;
  z-index: 4 !important;
  display: flex !important;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  border-radius: 8rpx;
  background: #c94635;
  color: #ffffff;
  font-size: 16rpx !important;
  font-weight: 900;
  line-height: 1 !important;
}

.day-cell.workday .holiday-status { background: #59626e; }
.day-cell.selected .holiday-status { box-shadow: 0 0 0 2rpx rgba(255,255,255,.78); }

.day-cell.selected .solar-day,
.day-cell.selected .lunar-day,
.day-cell.selected .day-mark {
  color: #ffffff;
}

.solar-day {
  font-size: 30rpx;
  font-weight: 900;
}

.lunar-day,
.day-mark {
  display: block;
  max-width: 100%;
  overflow: hidden;
  color: #74808c;
  font-size: 18rpx;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.day-mark {
  margin-top: 4rpx;
  color: #c94635;
}

.settings-card,
.detail-card {
  margin-top: 22rpx;
}

.section-title,
.switch-row,
.info-row,
.event-item,
.history-item,
.todo-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.event-item .event-day { flex: 0 0 126rpx; }
.event-main { display: flex; flex: 1; min-width: 0; align-items: center; gap: 10rpx; }
.event-main > text:first-child { flex: 1; min-width: 0; font-weight: 900; }
.event-status { flex: 0 0 auto; padding: 5rpx 10rpx; border-radius: 999rpx; background: rgba(23,111,118,.1); color: #176f76; font-size: 18rpx; font-weight: 900; }
.event-item.holiday { margin: 0 -10rpx; padding-right: 10rpx; padding-left: 10rpx; border-radius: 10rpx; background: rgba(201,70,53,.055); }
.event-item.holiday .event-main > text:first-child { color: #b92f24; }
.event-item.holiday .event-status { background: rgba(201,70,53,.13); color: #b92f24; }
.event-item.workday { margin: 0 -10rpx; padding-right: 10rpx; padding-left: 10rpx; border-radius: 10rpx; background: rgba(89,98,110,.055); }
.event-item.workday .event-main > text:first-child { color: #59626e; }
.event-item.workday .event-status { background: rgba(89,98,110,.12); color: #59626e; }

.section-title {
  margin-bottom: 14rpx;
  font-size: 30rpx;
  font-weight: 900;
}

.section-title > text:first-child {
  flex: 1;
  min-width: 0;
}

.section-title button {
  margin-left: auto;
}

.switch-row {
  padding: 16rpx 0;
  border-top: 1rpx solid #eadfce;
}

.detail-card {
  overflow: hidden;
}

.date-hero {
  padding: 28rpx;
  background: linear-gradient(135deg, #fff7eb, #eef7f4);
  text-align: center;
}

.date-hero text {
  display: block;
}

.weekday {
  color: #176f76;
  font-size: 24rpx;
  font-weight: 800;
}

.big-day {
  margin: 8rpx 0;
  color: #c94635;
  font-size: 112rpx;
  font-weight: 900;
  line-height: 1;
}

.solar {
  font-size: 32rpx;
  font-weight: 900;
}

.lunar {
  margin-top: 8rpx;
  color: #3f4854;
  font-size: 26rpx;
}

.almanac {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  margin-top: 20rpx;
}

.almanac text {
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
  padding: 14rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.74);
  color: #3f4854;
  font-size: 23rpx;
}

.almanac text:last-child {
  margin-right: 0;
}

.info-section {
  padding: 24rpx 28rpx;
  border-top: 1rpx solid #eadfce;
}

.section-heading {
  display: block;
  margin-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: 900;
}

.summary-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.summary-heading .section-heading { margin-bottom: 0; }
.summary-heading > view:first-child { flex: 1; min-width: 0; }
.summary-count { display: block; margin-top: 4rpx; color: #74808c; font-size: 21rpx; }
.summary-heading button { min-height: 62rpx; margin-left: auto; padding: 0 20rpx; border: 1rpx solid rgba(23,111,118,.4); background: rgba(23,111,118,.1); color: #176f76; font-size: 22rpx; font-weight: 900; }
.summary-item { display: flex; align-items: center; gap: 12rpx; padding: 14rpx 0; border-top: 1rpx solid rgba(234,223,206,.72); color: #3f4854; font-size: 25rpx; }
.summary-item > view { flex: 1; min-width: 0; }
.summary-item > view > text { display: block; }
.summary-dot { display: flex; flex: 0 0 38rpx; align-items: center; justify-content: center; width: 38rpx; height: 38rpx; border-radius: 50%; background: rgba(23,111,118,.12); color: #176f76; font-weight: 900; }
.anniversary-summary .summary-dot { border-radius: 8rpx; background: rgba(201,138,38,.14); color: #a56812; font-size: 18rpx; }
.diary-summary .summary-dot { border-radius: 8rpx; background: rgba(111,93,145,.14); color: #6f5d91; font-size: 18rpx; }
.diary-summary .summary-meta { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; white-space: pre-wrap; }
.summary-meta { margin-top: 4rpx; color: #74808c; font-size: 20rpx; }
.summary-item.done { color: #9aa3ad; text-decoration: line-through; }

.info-row,
.event-item,
.history-item,
.todo-item {
  padding: 14rpx 0;
  border-top: 1rpx solid rgba(234, 223, 206, 0.72);
  color: #3f4854;
  font-size: 25rpx;
}

.info-row text:first-child,
.event-item text:first-child,
.history-item text:first-child {
  flex: 0 0 auto;
  color: #74808c;
  font-weight: 800;
}

.info-row text:last-child,
.event-item text:last-child {
  flex: 1;
  min-width: 0;
  text-align: right;
}

.history-item {
  align-items: flex-start;
  justify-content: flex-start;
}

.history-item text:last-child {
  text-align: left;
}

.recommend-grid {
  display: flex;
  flex-direction: column;
}

.recommend-item {
  margin-bottom: 12rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #f6efe4;
}

.recommend-item:last-child {
  margin-bottom: 0;
}

.recommend-item text {
  display: block;
}

.recommend-item text:first-child {
  margin-bottom: 8rpx;
  color: #176f76;
  font-weight: 900;
}

.form-line {
  display: flex;
  align-items: stretch;
}

.form-line input {
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
  min-height: 72rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d8c7ad;
  border-radius: 10rpx;
  background: #fffdf8;
}

.form-line button {
  flex: 0 0 132rpx;
  width: 132rpx;
}

.empty {
  padding: 18rpx 0 4rpx;
  color: #74808c;
  font-size: 24rpx;
}

.todo-item {
  justify-content: flex-start;
}

.todo-item text {
  flex: 1;
  min-width: 0;
}

.todo-item .done {
  color: #9aa3ad;
  text-decoration: line-through;
}
