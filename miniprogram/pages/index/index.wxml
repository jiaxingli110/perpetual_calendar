<view class="page">
  <view class="topbar">
    <view>
      <text class="eyebrow">Lunar Calendar</text>
      <text class="title">万年历</text>
    </view>
    <button class="gear" bindtap="toggleSettings" aria-label="设置">⚙</button>
  </view>

  <view class="month-card">
    <view class="month-head">
      <button class="nav-button" bindtap="prevYear">‹</button>
      <view class="month-title">
        <text>{{monthTitle}}</text>
        <text class="month-meta">{{monthMeta}}</text>
      </view>
      <button class="nav-button" bindtap="nextYear">›</button>
    </view>

    <view class="controls">
      <button class="control-button" bindtap="prevMonth">上月</button>
      <picker mode="date" fields="month" value="{{pickerValue}}" start="1901-01" end="2100-12" bindchange="onMonthPick">
        <view class="picker-button">选择月份</view>
      </picker>
      <button class="control-button primary" bindtap="goToday">今天</button>
      <button class="control-button" bindtap="nextMonth">下月</button>
    </view>

    <view class="weekday-grid">
      <text wx:for="{{weekdays}}" wx:key="*this" class="{{index >= 5 ? 'weekend' : ''}}">{{item}}</text>
    </view>

    <view class="calendar-grid">
      <button
        wx:for="{{calendarDays}}"
        wx:key="key"
        class="day-cell {{item.isCurrentMonth ? '' : 'muted'}} {{item.isToday ? 'today' : ''}} {{item.isSelected ? 'selected' : ''}} {{item.isWeekend ? 'weekend' : ''}} {{item.isHoliday ? 'holiday' : ''}} {{item.isWorkday ? 'workday' : ''}}"
        data-date="{{item.key}}"
        bindtap="selectDate"
      >
        <image wx:if="{{item.termImage}}" class="day-background" src="{{item.termImage}}" mode="aspectFill" />
        <view wx:if="{{item.termImage}}" class="day-shade"></view>
        <text class="solar-day">{{item.day}}</text>
        <text wx:if="{{item.festivalText}}" class="festival-names">{{item.festivalText}}</text>
        <text wx:else class="lunar-day">{{item.badge}}</text>
        <text wx:if="{{item.mark}}" class="day-mark">{{item.mark}}</text>
        <text wx:if="{{item.holidayLabel}}" class="holiday-status">{{item.holidayLabel}}</text>
        <view wx:if="{{item.todoCount || item.anniversaryCount || item.diaryCount}}" class="day-indicators">
          <text wx:if="{{item.todoCount}}" class="todo-indicator">待</text>
          <text wx:if="{{item.anniversaryCount}}" class="anniversary-indicator">纪</text>
          <text wx:if="{{item.diaryCount}}" class="diary-indicator">记</text>
        </view>
      </button>
    </view>
  </view>

  <view wx:if="{{showSettings}}" class="settings-card">
    <view class="section-title">
      <text>组件</text>
      <button bindtap="toggleSettings">关闭</button>
    </view>
    <view class="switch-row" wx:for="{{componentOptions}}" wx:key="key">
      <text>{{item.label}}</text>
      <switch checked="{{item.checked}}" data-key="{{item.key}}" bindchange="toggleComponent" color="#176f76" />
    </view>
  </view>

  <view class="detail-card">
    <view class="date-hero">
      <text class="weekday">{{selected.weekday}}</text>
      <text class="big-day">{{selected.day}}</text>
      <text class="solar">{{selected.solar}}</text>
      <text class="lunar">{{selected.lunar}}</text>
      <view class="almanac">
        <text>宜 {{selected.good}}</text>
        <text>忌 {{selected.bad}}</text>
      </view>
    </view>

    <view wx:if="{{components.today}}" class="info-section">
      <text class="section-heading">今日信息</text>
      <view class="info-row"><text>农历</text><text>{{selected.lunar}}</text></view>
      <view class="info-row"><text>干支</text><text>{{selected.ganzhi}}</text></view>
      <view class="info-row"><text>节日/节气</text><text>{{selected.festivals}}</text></view>
    </view>

    <view wx:if="{{components.events}}" class="info-section">
      <text class="section-heading">本月节日</text>
      <view wx:for="{{monthEvents}}" wx:key="key" class="event-item {{item.type}}">
        <text class="event-day">{{item.day}}</text>
        <view class="event-main"><text>{{item.name}}</text><text class="event-status">{{item.status}}</text></view>
      </view>
    </view>

    <view wx:if="{{components.recommendations}}" class="info-section">
      <text class="section-heading">当季推荐</text>
      <view class="recommend-grid">
        <view wx:for="{{recommendations}}" wx:key="title" class="recommend-item">
          <text>{{item.title}}</text>
          <text>{{item.items}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{components.todos}}" class="info-section">
      <view class="summary-heading">
        <view><text class="section-heading">待办提醒</text><text class="summary-count">{{todos.length}} 项</text></view>
        <button bindtap="openTodos">管理待办</button>
      </view>
      <view wx:if="{{!todos.length}}" class="empty">选中日期暂无待办</view>
      <view wx:for="{{todos}}" wx:key="id" class="summary-item {{item.done ? 'done' : ''}}">
        <text class="summary-dot">{{item.done ? '✓' : '·'}}</text>
        <view><text>{{item.text}}</text><text class="summary-meta">{{item.time}} · {{item.reminder ? '提醒开启' : '无提醒'}}</text></view>
      </view>
    </view>

    <view wx:if="{{components.anniversaries}}" class="info-section">
      <view class="summary-heading">
        <view><text class="section-heading">纪念日</text><text class="summary-count">{{anniversaries.length}} 项</text></view>
        <button bindtap="openAnniversaries">管理纪念日</button>
      </view>
      <view wx:if="{{!anniversaries.length}}" class="empty">选中日期暂无纪念日</view>
      <view wx:for="{{anniversaries}}" wx:key="id" class="summary-item anniversary-summary">
        <text class="summary-dot">纪</text>
        <view><text>{{item.name}}</text><text class="summary-meta">{{item.type === 'lunar' ? '农历' : '公历'}} · 每年重复</text></view>
      </view>
    </view>

    <view wx:if="{{components.diaries}}" class="info-section">
      <view class="summary-heading">
        <view><text class="section-heading">日记</text><text class="summary-count">{{diaries.length}} 条</text></view>
        <button bindtap="openDiaries">写日记</button>
      </view>
      <view wx:if="{{!diaries.length}}" class="empty">选中日期还没有日记</view>
      <view wx:for="{{diaries}}" wx:key="id" class="summary-item diary-summary">
        <text class="summary-dot">记</text>
        <view><text>{{item.title || '无标题日记'}}</text><text class="summary-meta">{{item.content}}</text></view>
      </view>
    </view>

    <view class="info-section">
      <text class="section-heading">历史上的今天</text>
      <view wx:for="{{historyItems}}" wx:key="year" class="history-item">
        <text>{{item.year}}</text>
        <text>{{item.text}}</text>
      </view>
    </view>
  </view>
</view>
