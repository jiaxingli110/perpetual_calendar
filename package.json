{
  "name": "perpetual-calendar",
  "version": "0.1.0",
  "private": true,
  "description": "A cross-platform perpetual calendar app for Windows, Android, iOS, and iPadOS.",
  "main": "electron/main.cjs",
  "scripts": {
    "prepare:web": "node scripts/prepare-web.cjs",
    "start": "electron .",
    "build:windows": "electron-builder --win nsis portable",
    "cap:init": "npm run prepare:web && cap sync",
    "cap:add:android": "npm run prepare:web && cap add android",
    "cap:add:ios": "npm run prepare:web && cap add ios",
    "cap:android": "npm run prepare:web && cap sync android",
    "cap:ios": "npm run prepare:web && cap sync ios"
  },
  "build": {
    "appId": "com.example.perpetualcalendar",
    "productName": "万年历",
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "manifest.webmanifest",
      "service-worker.js",
      "assets/**/*",
      "icons/**/*",
      "electron/**/*"
    ],
    "win": {
      "icon": "icons/icon-512.png",
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "@capacitor/local-notifications": "^7.0.0"
  }
}
